page {
  width: 100vw;
  height: 100vh;
  background: #f6f9ff;
}

.page-shell {
  width: 100vw;
  height: 100vh;
  background: #f6f9ff;
}

.loading-card,
.error-card {
  position: fixed;
  left: 32rpx;
  right: 32rpx;
  top: 22vh;
  z-index: 9;
  padding: 44rpx 36rpx;
  border-radius: 36rpx;
  background: rgba(255, 255, 255, 0.92);
  box-shadow: 0 30rpx 80rpx rgba(22, 48, 88, 0.12);
  text-align: center;
}

.loading-logo {
  width: 96rpx;
  height: 96rpx;
  line-height: 96rpx;
  margin: 0 auto 22rpx;
  border-radius: 28rpx;
  background: #061a3a;
  color: #fff;
  font-weight: 900;
  letter-spacing: 1rpx;
}

.loading-title,
.error-title {
  font-size: 36rpx;
  font-weight: 900;
  color: #061a3a;
}

.loading-text,
.error-text {
  margin-top: 16rpx;
  font-size: 26rpx;
  line-height: 1.7;
  color: #65758f;
}

.retry-btn {
  margin-top: 30rpx;
  border-radius: 999rpx;
  background: #061a3a;
  color: #fff;
  font-weight: 800;
}
